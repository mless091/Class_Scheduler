{
  "name": "ClassScheduler",
  "version": "0.1.0",
  "private": true,
  "homepage": "./",
  "main": "./public/electron.js",
  "dependencies": {
    "@babel/core": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "@babel/preset-typescript": "^7.23.3",
    "@material-ui/core": "^4.12.4",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "11.2.7",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.69",
    "@types/react": "^17.0.0",
    "@types/react-dom": "17",
    "axios": "^1.6.7",
    "babel-jest": "^29.7.0",
    "buffer": "^6.0.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "enhanced-resolve": "^5.15.0",
    "install": "^0.13.0",
    "jest": "^29.7.0",
    "material-table": "1.69.3",
    "react": "^18.2.0",
    "react-dom": "^17.0.2",
    "react-router-dom": "^5.2.0",
    "react-scripts": "^5.0.1",
    "reflect-metadata": "^0.2.1",
    "sequelize": "^6.35.2",
    "sqlite3": "^5.0.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build:frontend": "webpack --config webpack.config.frontend.js",
    "build:backend": "webpack --config webpack.config.backend.js",
    "build": "npm run build:frontend && npm run build:backend",
    "test": "jest",
    "eject": "react-scripts eject",
    "electron:start": "concurrently -k \"cross-env BROWSER=none yarn start\" \"wait-on tcp:127.0.0.1:3000 && npx electronmon .\" \"ts-node ./src/backend/backend\"",
    "electron:watch": "wait-on tcp:127.0.0.1:3000 && npx electronmon .",
    "electron:package:mac": "yarn build && electron-builder -m -c.extraMetadata.main=build/electron.js",
    "electron:package:win": "yarn build && electron-builder -w -c.extraMetadata.main=build/electron.js",
    "electron:package:linux": "yarn build && electron-builder -l -c.extraMetadata.main=build/electron.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      "last 1 electron version"
    ],
    "development": [
      "last 1 electron version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@types/cors": "^2.8.17",
    "@types/es6-shim": "^0.31.45",
    "@types/react-router-dom": "^5.3.3",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electronmon": "^2.0.2",
    "express": "^4.18.2",
    "jest-fetch-mock": "^3.0.3",
    "typescript": "4.5.4",
    "util": "^0.12.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.electron.myapp",
    "productName": "My Electron App",
    "files": [
      "build/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "public"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "deb"
    }
  }
}
